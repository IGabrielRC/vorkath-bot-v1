    {
      "parameters": {
        "jsCode": "for (const item of items) {\n  const datos = item.json;\n\n  // 1. RECUPERAMOS LOS 4 VALORES QUE QUIERES CONSERVAR\n  const fecha = datos['fecha'];\n  const bcv_usd = datos['oficial_bcv_usd'];\n  const bcv_eur = datos['oficial_bcv_eur'];\n  const p2p_final = datos['mi_p2p_final'];\n\n  // 2. CÁLCULO DE LA TASA PROMEDIO (Euro + Tu P2P / 2)\n  const promedio_calculado = (bcv_eur + p2p_final) / 2;\n\n  // 3. CÁLCULOS DE LOS PACKS\n  const valor_5_5 = promedio_calculado * 5.5;\n  const valor_3_5 = promedio_calculado * 3.5;\n  const valor_5 = promedio_calculado * 5;\n  const valor_7 = promedio_calculado * 7;\n  const valor_9 = promedio_calculado * 9;\n  const valor_4 = promedio_calculado * 4;\n  const valor_15 = promedio_calculado * 15;\n\n  // 4. LIMPIEZA Y ENTREGA FINAL\n  item.json = {\n    fecha: fecha,\n    oficial_bcv_usd: bcv_usd,\n    oficial_bcv_eur: bcv_eur,\n    mi_p2p_final: p2p_final,\n    tasa_promedio_mix: Math.round(promedio_calculado * 100) / 100,\n    valor_5_5usd: Math.round(valor_5_5 * 100) / 100,\n    valor_3_5usd: Math.round(valor_3_5 * 100) / 100,\n    valor_5_usd: Math.round(valor_5 * 100) / 100,\n    valor_7_usd: Math.round(valor_7 * 100) / 100,\n    valor_9_usd: Math.round(valor_9 * 100) / 100,\n    valor_4_usd: Math.round(valor_4 * 100) / 100,\n    valor_15_usd: Math.round(valor_15 * 100) / 100\n  };\n}\n\nreturn items;"
      },
