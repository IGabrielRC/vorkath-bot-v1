    {
      "parameters": {
        "jsCode": "const fecha_hoy = new Date().toISOString().split('T')[0];\n\nlet bcv_dolar = 0.0;\nlet bcv_euro = 0.0;\nlet p2p_usdt = 0.0;\n\nfor (const item of items) {\n  const datos = item.json;\n\n  // --- PROCESAR DATOS BCV ---\n  if ('tasa_dolar' in datos) {\n    const txt_dolar = datos['tasa_dolar'].replace(',', '.').trim();\n    bcv_dolar = parseFloat(txt_dolar);\n\n    const txt_euro = datos['tasa_euro'].replace(',', '.').trim();\n    bcv_euro = parseFloat(txt_euro);\n  }\n\n  // --- PROCESAR DATOS API (P2P) ---\n  if ('promedio' in datos) {\n    p2p_usdt = parseFloat(datos['promedio']);\n  }\n}\n\n// --- CÁLCULOS ---\nconst p2p_con_aumento = p2p_usdt * 1.05;\n\nreturn [{\n  json: {\n    fecha: fecha_hoy,\n    oficial_bcv_usd: Math.round(bcv_dolar * 100) / 100,\n    oficial_bcv_eur: Math.round(bcv_euro * 100) / 100,\n    mi_p2p_final: Math.round(p2p_con_aumento * 100) / 100,\n    mercado_p2p_base: Math.round(p2p_usdt * 100) / 100\n  }\n}];"
      },
