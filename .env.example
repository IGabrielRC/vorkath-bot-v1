# Vokath Bot v1 — environment template (no secrets, placeholders only)
NODE_ENV=development
PORT=3000
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_WEBHOOK_SECRET=your-long-random-webhook-secret-here
AUTHORIZED_TELEGRAM_USER_IDS=111111111,222222222
# OPTIONAL — leave unset/empty for no chat restriction (only
# AUTHORIZED_TELEGRAM_USER_IDS is enforced). When set, the chat restriction
# applies on top of user authorization. Private operating group both owners
# share (chat.id). Group ids are NEGATIVE — get yours via @userinfobot or
# getUpdates after adding the bot.
# AUTHORIZED_TELEGRAM_CHAT_IDS=-1001234567890
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash
PUBLIC_BASE_URL=https://your-public-url.example.com
REGISTER_TELEGRAM_WEBHOOK=false
MOCK_STATE_PATH=/data/mock-state.json
DRAFTS_STATE_PATH=/data/drafts-state.json
INTERACTIONS_STATE_PATH=/data/interactions-state.json
# OPTIONAL — OperatorProfile snapshot (auto-created display names per
# telegramUserId, refreshed from Telegram `from` fields on every update).
# Defaults to /data so profiles survive redeploys with no new variable.
# OPERATOR_PROFILES_STATE_PATH=/data/operator-profiles-state.json
# IMPORTANT: Group Privacy Mode must be OFF in BotFather (Bot Settings →
# Group Privacy → Turn off) so the bot receives NORMAL group messages, not
# only /commands, replies, and @mentions. With privacy ON the shared-group
# flow silently misses plain messages.
# OPTIONAL — forum Topics mode. Leave unset/empty for Mode A (current
# group-first behavior, unchanged). When set, each operator may act ONLY
# inside their assigned topic; writes elsewhere are rejected with a guide
# reply and execute nothing. Format: userId:threadId pairs (positive
# integers, no hardcoding elsewhere). Malformed values fail fast at boot.
# To obtain each message_thread_id: temporarily enable forum topics in the
# group, send a message in each operator topic, then call
# GET https://api.telegram.org/bot<TOKEN>/getUpdates and read
# result[].message.message_thread_id (or message_thread_id inside
# callback_query.message for button taps).
# TELEGRAM_OPERATOR_TOPICS=1057242322:101,941030473:202
# OPTIONAL — activity topic for the single allowed summary event (a
# secrets-free note on confirmed operations). Unset/empty disables it.
# TELEGRAM_ACTIVITY_TOPIC_ID=303
# OPTIONAL — alerts topic (⭐ Alertas) for critical-alert delivery used by
# /testalert and future confirmed business events (sales, renewals,
# payments — NOT implemented yet). Unset/empty disables alert delivery
# without breaking startup or /health. Never receives secrets.
# TELEGRAM_ALERTS_TOPIC_ID=505
